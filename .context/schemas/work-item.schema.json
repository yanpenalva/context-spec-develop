{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanpenalva/context-spec-develop/schemas/work-item.schema.json",
  "title": "context-spec-develop work item",
  "type": "object",
  "required": ["schema_version", "id", "title", "track", "type", "phase", "status", "risk", "owner", "conversation_profile", "last_updated"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "track": {"enum": ["product", "support"]},
    "type": {"enum": ["feature", "bug", "incident", "hotfix"]},
    "phase": {"enum": ["discover", "triage", "contain", "specify", "plan", "preflight", "execute", "verify", "release", "observe", "learn", "close"]},
    "status": {"enum": ["draft", "ready", "active", "blocked", "completed", "cancelled"]},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "owner": {"type": "string", "minLength": 1},
    "conversation_profile": {"type": "string", "minLength": 1},
    "git_finalization_mode": {"enum": ["confirm_each", "automatic"]},
    "last_updated": {"type": "string", "format": "date"},
    "severity": {"enum": ["sev1", "sev2", "sev3", "sev4"]},
    "implementation_required": {"type": "boolean"},
    "phase_history": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "policy_exceptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complexity", "impact", "security", "confidence", "routing"],
      "properties": {
        "complexity": {"enum": ["low", "medium", "high"]},
        "impact": {"enum": ["local", "module", "cross-module", "system"]},
        "security": {"enum": ["none", "relevant", "sensitive"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "routing": {"enum": ["minimal", "standard", "extended"]}
      }
    },
    "reclassification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["previous", "trigger", "routing_impact"],
        "properties": {
          "previous": {
            "type": "object",
            "additionalProperties": false,
            "required": ["complexity", "impact", "security", "confidence", "routing"],
            "properties": {
              "complexity": {"enum": ["low", "medium", "high"]},
              "impact": {"enum": ["local", "module", "cross-module", "system"]},
              "security": {"enum": ["none", "relevant", "sensitive"]},
              "confidence": {"enum": ["low", "medium", "high"]},
              "routing": {"enum": ["minimal", "standard", "extended"]}
            }
          },
          "trigger": {"type": "string", "minLength": 1},
          "routing_impact": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"track": {"const": "product"}}}, "then": {"properties": {"type": {"const": "feature"}}}},
    {"if": {"properties": {"type": {"enum": ["incident", "hotfix"]}}}, "then": {"required": ["severity"]}},
    {"if": {"properties": {"type": {"const": "incident"}}}, "then": {"properties": {"track": {"const": "support"}}}},
    {"if": {"properties": {"type": {"const": "hotfix"}}}, "then": {"properties": {"track": {"const": "support"}}}}
  ],
  "additionalProperties": false
}
